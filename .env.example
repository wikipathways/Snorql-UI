# =============================================================================
# Snorql-UI Configuration
# =============================================================================
# Copy this file to .env and customize the values for your deployment.
# Docker Compose automatically reads .env files in the same directory.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   docker compose up -d

# ---------------------------------------------------------------------------
# Virtuoso SPARQL Endpoint Settings
# ---------------------------------------------------------------------------
VIRTUOSO_CONTAINER=my-virtuoso
VIRTUOSO_HOST=localhost
VIRTUOSO_HTTP_PORT=8890
VIRTUOSO_ISQL_PORT=1111
VIRTUOSO_USER=dba
VIRTUOSO_PASSWORD=dba123
SPARQL_UPDATE=false

# ---------------------------------------------------------------------------
# Snorql-UI Web Interface Settings
# ---------------------------------------------------------------------------
SNORQL_CONTAINER=my-snorql
SNORQL_PORT=8088
SNORQL_ENDPOINT=http://localhost:8890/sparql
SNORQL_EXAMPLES_REPO=https://github.com/your-org/your-sparql-queries
SNORQL_TITLE=My SPARQL Explorer
DEFAULT_GRAPH=
WELCOME_TITLE=SPARQL Query Explorer
WELCOME_MESSAGE=

# ---------------------------------------------------------------------------
# CORS Settings (for enable-cors.sh script)
# ---------------------------------------------------------------------------
# Use '*' for development or 'http://yourdomain.com' for production
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Query Reliability Settings (Phase 9)
# ---------------------------------------------------------------------------
# Injected at container start into CONFIG.queryTimeoutMs, CONFIG.maxGetUrlBytes
# and CONFIG.sendPrefixBlock in assets/js/config.js (see script.sh). Leave a
# variable unset to keep the value in config.js.

# XHR timeout for SPARQL queries (milliseconds). Default 60000 = 60 seconds.
# Bump for federated or heavy aggregations.
SNORQL_QUERY_TIMEOUT_MS=60000

# Threshold (bytes) above which queries switch from GET to POST and permalinks
# are refused. Default 4000 is conservative; nginx and Cloudflare both
# typically allow up to 8192. Measured against URL-encoded prefixed query.
SNORQL_MAX_GET_URL_BYTES=4000

# PREFIX block delivery mode. 'auto' (default) sends only used-and-undeclared
# prefixes from CONFIG.namespaces. 'true' force-prepends all of them. 'false'
# skips entirely (Virtuoso-only forks with server-registered prefixes).
SNORQL_SEND_PREFIX_BLOCK=auto

# Bitly access token for "Get Permalink" short links. Visible to anyone who
# loads the page. Set it empty to disable shortening (the full link is shown);
# leave it unset to keep bitlyToken from config.js.
# SNORQL_BITLY_TOKEN=
